{
  "name": "oneshot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One Shot: browser-based 3D sniper duels, 1v1.",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @oneshot/client",
    "build": "npm run build -w @oneshot/client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "assets": "node tools/assets/fetch-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
